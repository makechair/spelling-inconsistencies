[Unit]
Description=Build the Notion event study from local daily/news Parquet
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/usstocks/corpus/universe/sectors.parquet

[Service]
Type=oneshot
User=usstocks
Group=usstocks
WorkingDirectory=/var/lib/usstocks
EnvironmentFile=/etc/usstocks/usstocks.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env USSTOCKS_CORPUS_LOCAL_DIR=/var/lib/usstocks/corpus /opt/usstocks/current/venv/bin/python -m usstocks.corpus.event_study

PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/usstocks
ProtectHome=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

# DuckDB is explicitly limited to one thread and 256 MB internally. The
# systemd ceiling leaves room for Python, Arrow and report serialization.
MemoryMax=512M
TimeoutStartSec=900

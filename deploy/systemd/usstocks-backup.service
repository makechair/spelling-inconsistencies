[Unit]
Description=Consistent SQLite backup to Amazon S3
After=network-online.target

[Service]
Type=oneshot
User=usstocks
Group=usstocks
EnvironmentFile=/etc/usstocks/usstocks.env
ExecStart=/opt/usstocks/deploy/backup/backup.sh
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/usstocks /var/backups/usstocks

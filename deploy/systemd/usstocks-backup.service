[Unit]
Description=Consistent SQLite backup to Amazon S3
After=network-online.target

[Service]
Type=oneshot
User=usstocks
Group=usstocks
EnvironmentFile=/etc/usstocks/usstocks.env
ExecStart=/usr/bin/env USSTOCKS_DB_PATH=/var/lib/usstocks/market.db USSTOCKS_BACKUP_DIR=/var/backups/usstocks /opt/usstocks/current/backup.sh
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/usstocks /var/backups/usstocks
ProtectHome=true
NoNewPrivileges=true
UMask=0027

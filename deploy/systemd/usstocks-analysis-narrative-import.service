[Unit]
Description=Import local-Qwen analysis narrative sidecars from S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=usstocks
Group=usstocks
EnvironmentFile=/etc/usstocks/usstocks.env
ExecStart=/opt/usstocks/current/analysis-import.sh

PrivateTmp=true
ProtectSystem=strict
# Both directories this script writes. The fundamentals guide was added to
# the script without being added here, so every run since has died on
# ProtectSystem with "Read-only file system" -- ninety-six failures a day, and
# the decision digest never arrived. A path added to the script has to be
# added here in the same change.
ReadWritePaths=/var/lib/usstocks/corpus/analysis /var/lib/usstocks/corpus/fundamentals
ProtectHome=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

MemoryMax=128M
TimeoutStartSec=180

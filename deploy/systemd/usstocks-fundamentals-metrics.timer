[Unit]
Description=Recompute fundamentals metrics after both filing loaders

[Timer]
# 07:30 UTC = 16:30 JST. This has to sit after *both* sources of facts, not
# just EDGAR: the EDINET extractor finishes around 06:50-07:00 UTC, and while
# this ran at 05:45 the Japanese filings only reached the table on the
# following day's pass. Backup takes 07:10-07:20, so this is clear of it too.
#
# Moving this earlier silently reintroduces the one-day lag for every Japanese
# symbol, and nothing fails to say so.
OnCalendar=*-*-* 07:30:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target

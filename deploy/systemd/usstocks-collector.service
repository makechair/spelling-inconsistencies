# Alternative to Docker Compose (spec 4.6). Use one or the other, not both.
[Unit]
Description=US stocks market data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=usstocks
Group=usstocks
WorkingDirectory=/opt/usstocks
EnvironmentFile=/etc/usstocks/usstocks.env
ExecStart=/opt/usstocks/.venv/bin/python -m usstocks.collector

# Spec 4.4: restart automatically on abnormal exit.
Restart=always
RestartSec=5
# Do not give up after repeated failures; a provider outage can exceed any
# burst window and the collector must come back on its own.
StartLimitIntervalSec=0

# Spec 12: keep one process from taking down a 1 GB instance.
MemoryMax=320M
OOMPolicy=stop

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/usstocks /dev/shm
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

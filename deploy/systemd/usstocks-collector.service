# Direct-host runtime. Do not run this alongside the Compose collector.
[Unit]
Description=US stocks market data collector
After=network-online.target
Wants=network-online.target
# A provider outage can outlast any burst window. Keep retrying indefinitely.
StartLimitIntervalSec=0

[Service]
Type=simple
User=usstocks
Group=usstocks
WorkingDirectory=/var/lib/usstocks
EnvironmentFile=/etc/usstocks/usstocks.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Command-level assignments intentionally override any development paths left
# in the shared EnvironmentFile.
ExecStart=/usr/bin/env USSTOCKS_DB_PATH=/var/lib/usstocks/market.db USSTOCKS_LIVE_DB_PATH=/dev/shm/usstocks-live.db /opt/usstocks/current/venv/bin/python -m usstocks.collector

# Spec 4.4: restart automatically on abnormal exit.
Restart=always
RestartSec=5
# Spec 12: keep one process from taking down a 1 GB instance.
MemoryMax=320M
OOMPolicy=stop
LimitNOFILE=8192
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/usstocks /dev/shm
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

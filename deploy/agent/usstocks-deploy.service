[Unit]
Description=Pull and deploy the latest application revision
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PROJECT=usstocks
Environment=DEPLOY_BRANCH=main
Environment=DEPLOY_RUNTIME=systemd
Environment=DEPLOY_KEEP_RELEASES=3
# Deploy key for the private repository, installed out of band.
Environment="GIT_SSH_COMMAND=ssh -i /var/lib/usstocks/.ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
ExecStart=/opt/usstocks/app/deploy/agent/deploy-agent.sh
TimeoutStartSec=900

# Root is required only for the atomic /opt symlink switch and restarting the
# two app units. The application itself and pip builds run as `usstocks`.
Restart=no

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/usstocks /var/cache/usstocks
RuntimeDirectory=usstocks-deploy
RuntimeDirectoryMode=0750
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

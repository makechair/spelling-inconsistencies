<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.makechair.usstocks-analysis-narrative</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__SCRIPT__</string>
    <string>--exchange-s3-uri</string>
    <string>__EXCHANGE_URI__</string>
    <string>--aws-profile</string>
    <string>usstocks-qwen</string>
    <string>--model</string>
    <string>qwen3:14b</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>14</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/analysis-narrative.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/analysis-narrative-error.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>

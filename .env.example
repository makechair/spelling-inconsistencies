# Copy to .env and fill in. Never commit the result (spec 4.5).
# All settings are optional unless marked required; defaults live in
# src/usstocks/config.py.

# ----------------------------------------------------------------- storage
USSTOCKS_DB_PATH=./data/market.db
# Ephemeral live state. On the server point this at tmpfs (/dev/shm/live.db):
# it is rebuilt from the next trade, so persisting it only wears the SSD.
USSTOCKS_LIVE_DB_PATH=./data/live.db

# ------------------------------------------------------------- market data
# tiingo | alpaca | mock   (mock generates fake data for local development)
USSTOCKS_PRIMARY_SOURCE=tiingo
# Which provider wins when both hold the same minute (spec-review B-1).
USSTOCKS_SOURCE_PRIORITY=tiingo,alpaca

# required when PRIMARY_SOURCE=tiingo
USSTOCKS_TIINGO_API_KEY=
# 5 = trades only. Subscribing to quotes multiplies bandwidth and cannot
# produce OHLCV anyway (spec-review A-1, B-3).
USSTOCKS_TIINGO_THRESHOLD_LEVEL=5

# Standby provider (spec 5.2). Switching is a manual decision.
USSTOCKS_ALPACA_API_KEY=
USSTOCKS_ALPACA_API_SECRET=

# ---------------------------------------------------------- free-tier budget
# Enforced locally so a reconnect storm cannot burn the allowance
# (spec-review A-2). Raise these if you move to a paid plan.
USSTOCKS_REST_CALLS_PER_HOUR=50
USSTOCKS_REST_CALLS_PER_DAY=1000
# Measured, not assumed. Watch /api/health during phase 1 (spec-review A-1).
USSTOCKS_MONTHLY_BANDWIDTH_BYTES=1000000000
USSTOCKS_BANDWIDTH_WARN_RATIO=0.8

USSTOCKS_MAX_SYMBOLS=30
# 0 = do not store second-level snapshots (spec 10.2 default choice).
USSTOCKS_TICK_RETENTION_DAYS=0

# --------------------------------------------------------------------- api
USSTOCKS_API_HOST=127.0.0.1
USSTOCKS_API_PORT=8000

# -------------------------------------------------------------------- auth
# cloudflare_access | disabled
# "disabled" is refused on any non-loopback bind address (spec-review A-4).
USSTOCKS_AUTH_MODE=cloudflare_access
# Your Cloudflare Zero Trust team domain.
USSTOCKS_CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# The Access application's Audience (AUD) tag.
USSTOCKS_CF_ACCESS_AUD=
# Only these addresses may use the app (spec 3.5).
USSTOCKS_ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------- runtime
USSTOCKS_LOG_LEVEL=INFO

# -------------------------------------------------- deployment (not app config)
# Used by docker-compose.yml and the backup scripts.
CLOUDFLARE_TUNNEL_TOKEN=
USSTOCKS_BACKUP_S3_URI=
USSTOCKS_BACKUP_DIR=/var/backups/usstocks
AWS_DEFAULT_REGION=ap-northeast-1

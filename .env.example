# Copy to .env and fill in. Never commit the result (spec 4.5).
# All settings are optional unless marked required; defaults live in
# src/usstocks/config.py.

# ----------------------------------------------------------------- storage
USSTOCKS_DB_PATH=./data/market.db
# Ephemeral live state. On the server point this at tmpfs (/dev/shm/live.db):
# it is rebuilt from the next trade, so persisting it only wears the SSD.
USSTOCKS_LIVE_DB_PATH=./data/live.db

# ------------------------------------------------------------- market data
# tiingo | alpaca | mock   (mock generates fake data for local development)
USSTOCKS_PRIMARY_SOURCE=tiingo
# Which provider wins when both hold the same minute (spec-review B-1).
USSTOCKS_SOURCE_PRIORITY=tiingo,alpaca

# required when PRIMARY_SOURCE=tiingo
USSTOCKS_TIINGO_API_KEY=
# IEX websocket threshold level. Leave empty unless you know your plan accepts
# a specific level: sending one it does not allow is refused at subscribe time
# and the socket is closed, so the collector reconnects forever without
# receiving a trade.
#   tiingo stream error: thresholdLevel not valid for your subscription tier
# 5 (trades only) is the level this workload wants where it is permitted --
# quotes carry no size, cannot produce OHLCV, and dominate the 1 GB/month
# budget (spec-review A-1, B-3). Watch /api/health after changing it.
USSTOCKS_TIINGO_THRESHOLD_LEVEL=

# Standby provider (spec 5.2). Switching is a manual decision.
USSTOCKS_ALPACA_API_KEY=
USSTOCKS_ALPACA_API_SECRET=
# "iex" on the free plan, "sip" on a paid one. SIP is the consolidated tape --
# every venue rather than the ~2-3% of volume IEX sees -- which is the whole
# difference between a sparse chart and a continuous one. Drives both the REST
# parameter and the websocket URL.
USSTOCKS_ALPACA_FEED=iex

# ---------------------------------------------------------- free-tier budget
# Enforced locally so a reconnect storm cannot burn the allowance
# (spec-review A-2). Raise these if you move to a paid plan.
USSTOCKS_REST_CALLS_PER_HOUR=50
USSTOCKS_REST_CALLS_PER_DAY=1000
# REST polling. Neither provider's free tier delivers websocket data any more
# (spec-review A-6), so these decide how live the chart is. 50 calls/hour spread
# over ten symbols is one refresh every 12 minutes; aimed at the symbol on
# screen it is one every ~90 seconds. The rest are deferred, not dropped: a REST
# call returns every minute since the last stored bar, so an unopened symbol
# fills completely the moment it is opened.
USSTOCKS_FOREGROUND_POLL_SECONDS=90
# Insurance, not freshness: backfill reaches back only 30 days, so a symbol left
# unopened past that would lose history for good.
USSTOCKS_BACKGROUND_POLL_SECONDS=1800
# How long after a request a symbol still counts as being watched. A closed
# browser stops spending the allowance on a chart nobody is reading.
USSTOCKS_VIEWER_IDLE_SECONDS=300

# Measured, not assumed. Watch /api/health during phase 1 (spec-review A-1).
USSTOCKS_MONTHLY_BANDWIDTH_BYTES=1000000000
USSTOCKS_BANDWIDTH_WARN_RATIO=0.8

# 10, not the spec's 30: see docs/spec-review.md A-1 for the bandwidth math.
USSTOCKS_MAX_SYMBOLS=10
# Collector liveness heartbeat. Independent from trade traffic, so a closed
# market does not trigger a false stale alert.
USSTOCKS_COLLECTOR_STATUS_INTERVAL_SECONDS=15
# 0 = do not store second-level snapshots (spec 10.2 default choice).
USSTOCKS_TICK_RETENTION_DAYS=0

# --------------------------------------------------------------------- api
USSTOCKS_API_HOST=127.0.0.1
USSTOCKS_API_PORT=8000

# -------------------------------------------------------------------- auth
# cloudflare_access | disabled
# "disabled" is refused on any non-loopback bind address (spec-review A-4).
USSTOCKS_AUTH_MODE=cloudflare_access
# Your Cloudflare Zero Trust team domain.
USSTOCKS_CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# The Access application's Audience (AUD) tag.
USSTOCKS_CF_ACCESS_AUD=
# Only these addresses may use the app (spec 3.5). One address, or several
# separated by commas. Must match what the Access policy admits: Cloudflare
# letting an address through while this list omits it produces a 403 from the
# app itself, after a successful login.
USSTOCKS_ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------- runtime
USSTOCKS_LOG_LEVEL=INFO

# -------------------------------------------------- deployment (not app config)
# Used by docker-compose.yml and the backup scripts.
CLOUDFLARE_TUNNEL_TOKEN=
USSTOCKS_BACKUP_S3_URI=
USSTOCKS_BACKUP_DIR=/var/backups/usstocks
AWS_DEFAULT_REGION=ap-northeast-1
